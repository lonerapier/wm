# Environment Configuration for Training, W&B, Hugging Face, and Vast.ai


# Get your API key at: https://wandb.ai/authorize
WANDB_API_KEY=your_wandb_api_key_here
WANDB_PROJECT=wm
WANDB_ENTITY=

# Create a Hugging Face user access token with WRITE permissions at:
# https://huggingface.co/settings/tokens
HF_TOKEN=your_huggingface_token_here

# Target repository (e.g., "your_username/wm-checkpoints")
# Will be automatically created as a private model repository if it does not exist.
HF_REPO_ID=your_username/wm-checkpoints
HF_REPO_TYPE=model
HF_PRIVATE=true
HF_PREFIX=runs

# Get your Vast.ai API key at: https://cloud.vast.ai/account/
VAST_API_KEY=your_vast_api_key_here
